{
  "name": "vibegene",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "vite build",
    "build:desktop": "vite build && node scripts/strip-tauri-downloads.mjs",
    "build:primer3-wasm": "bash scripts/build-primer3-wasm.sh",
    "build:primer3-thal-wasm": "bash scripts/build-primer3-thal-wasm.sh",
    "deploy:pages": "npm run build:web && wrangler pages deploy",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:application-strict": "tsc -p tsconfig.application.json",
    "check:lint-baseline": "node scripts/check-eslint-baseline.mjs",
    "update:lint-baseline": "node scripts/check-eslint-baseline.mjs --update-baseline",
    "cloudflare:types": "wrangler types workers/telemetry-api/worker-configuration.d.ts --include-runtime=false --config workers/telemetry-api/wrangler.jsonc && wrangler types workers/telemetry-admin/worker-configuration.d.ts --include-runtime=false --config workers/telemetry-admin/wrangler.jsonc",
    "cloudflare:migrate": "wrangler d1 migrations apply vibegene-telemetry --remote --config workers/telemetry-api/wrangler.jsonc",
    "cloudflare:deploy:api": "wrangler deploy --config workers/telemetry-api/wrangler.jsonc",
    "cloudflare:deploy:admin": "wrangler deploy --config workers/telemetry-admin/wrangler.jsonc",
    "lint": "eslint .",
    "check:theme": "tsx scripts/check-theme-colors.ts",
    "check:theme-debt": "tsx scripts/check-theme-debt.ts",
    "generate:theme-debt-candidate": "tsx scripts/generate-theme-debt-manifest.ts --candidate",
    "accept:theme-debt": "tsx scripts/accept-theme-debt-manifest.ts --accept-reviewed",
    "plan:theme-migration": "tsx scripts/plan-theme-migration.ts",
    "test:theme": "vitest run scripts/check-theme-colors.test.ts scripts/scientific-renderer-theme-contract.test.ts",
    "test:theme-debt": "vitest run scripts/check-theme-debt.test.ts",
    "test:theme-migration": "vitest run scripts/plan-theme-migration.test.ts scripts/accept-theme-debt-manifest.test.ts scripts/semantic-palette-tranche.test.ts scripts/semantic-palette-contract.test.ts scripts/bulk-theme-groups.test.ts scripts/compound-paint-groups.test.ts scripts/neutral-text-chrome-candidates.test.ts scripts/neutral-text-chrome-candidates-applied.test.ts scripts/interactive-state-candidates.test.ts scripts/interactive-state-candidates-applied.test.ts scripts/interaction-state-matrix.test.ts",
    "test:theme-ui": "playwright test --config=playwright.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "vitest run",
    "generate:enzymes": "tsx scripts/generate-enzymes-json.ts",
    "generate:common-features": "tsx scripts/generate-common-features-json.ts",
    "generate:mw-ladders": "tsx scripts/generate-mw-ladder-catalog.ts",
    "generate:ta-gc-vectors": "tsx scripts/generate-ta-gc-vector-catalog.ts",
    "generate:gateway-vectors": "tsx scripts/generate-gateway-vector-catalog.ts",
    "fetch:thermo": "tsx scripts/fetch-thermo-buffer-chart.ts",
    "fetch:sibenzyme": "tsx scripts/fetch-sibenzyme-buffer-chart.ts",
    "fetch:usb": "tsx scripts/fetch-usb-buffer-chart.ts",
    "fetch:vivantis": "tsx scripts/fetch-vivantis-buffer-chart.ts",
    "fetch:vivantis:merge-poster": "tsx scripts/fetch-vivantis-buffer-chart.ts --merge-poster",
    "fetch:vivantis:fill-gaps": "tsx scripts/fetch-vivantis-buffer-chart.ts --fill-gaps",
    "fetch:roche": "tsx scripts/fetch-roche-buffer-chart.ts",
    "fetch:jena": "tsx scripts/fetch-jena-buffer-chart.ts",
    "fetch:eurx": "tsx scripts/fetch-eurx-buffer-chart.ts",
    "measure:map-layout": "tsx scripts/measure-map-layout.ts",
    "measure:startup": "tsx scripts/measure-startup.ts",
    "benchmark:enzymes": "tsx scripts/benchmark-enzyme-scanner.ts",
    "analyze:feature-levels": "tsx scripts/analyze-feature-levels.ts"
  },
  "dependencies": {
    "@shandley/primd": "^0.3.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "fflate": "^0.8.3",
    "immunum": "1.2.0",
    "lucide-react": "^1.16.0",
    "lzma-wasm": "^1.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260901.1",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^5.6.205",
    "tsx": "^4.22.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "wrangler": "^4.127.1"
  }
}
